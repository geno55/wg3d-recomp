+// wg3d (patch 0003): the idle thread (pause_self) waits here, so while it does, every other game thread
+// is blocked. is_game_idle() is used by the VI thread's lockstep mode (speed multiplier > 1).
+static std::atomic<bool> idle_waiting{ false };
+// The last message the idle thread took couldn't be delivered (its queue is full) and was requeued. It
+// stays queued until a game thread drains that queue, which needs the next VI, so it doesn't count as work.
+static std::atomic<bool> undeliverable{ false };
+
+void ultramodern::wait_for_external_message_idle(RDRAM_ARG1) {
+    QueuedMessage to_send;
+    idle_waiting = true;
+    external_messages.wait_dequeue(to_send);
+    idle_waiting = false;
+    if (do_send(PASS_RDRAM to_send.mq, to_send.mesg, to_send.jam, false)) {
+        undeliverable = false;
+    } else if (to_send.requeue_if_blocked) {
+        undeliverable = true;
+        external_messages.enqueue(to_send);
+    }
+}
+
+bool ultramodern::is_game_idle() {
+    return idle_waiting.load() && (external_messages.size_approx() == 0 || undeliverable.load());
+}
+
