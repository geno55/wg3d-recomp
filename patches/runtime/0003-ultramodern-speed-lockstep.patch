+// wg3d (patch 0003): in lockstep mode (speed multiplier > 1) VIs don't follow the wall clock, so the
+// count/time the game reads follows the VIs instead: 1/60 s of N64 time per VI, plus the scaled wall time
+// since the last VI, capped below one VI so time never runs ahead of the next one.
+static std::atomic<uint64_t> lockstep_vis{ 0 };
+static std::atomic<int64_t> lockstep_last_vi_ns{ 0 };
+constexpr uint64_t ticks_per_vi = 46'875'000 / 60;
+
+void ultramodern::lockstep_vi() {
+    lockstep_last_vi_ns = std::chrono::duration_cast<std::chrono::nanoseconds>(
+        std::chrono::high_resolution_clock::now().time_since_epoch()).count();
+    lockstep_vis++;
+}
+
 uint64_t time_now() {
+    if (speed_multiplier > 1) {
+        int64_t now_ns = std::chrono::duration_cast<std::chrono::nanoseconds>(
+            std::chrono::high_resolution_clock::now().time_since_epoch()).count();
+        uint64_t since = (uint64_t)std::max<int64_t>(0, now_ns - lockstep_last_vi_ns.load());
+        uint64_t extra = std::min<uint64_t>(since * 46'875 * speed_multiplier / 1'000'000, ticks_per_vi - 1);
+        return lockstep_vis.load() * ticks_per_vi + extra;
+    }
     return duration_to_ticks(std::chrono::high_resolution_clock::now() - start_time);
 }
 
